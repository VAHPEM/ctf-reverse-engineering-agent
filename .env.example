# ctf-brain configuration — copy this file to `.env` and fill in real values.
# `.env` is git-ignored; NEVER commit it or your keys.

# --- Brain (LLM) ---
# API keys for whichever provider your chosen models use.
ANTHROPIC_API_KEY=sk-ant-...            # required for claude-* models (the tested path)
OPENAI_API_KEY=sk-...                   # optional; gpt-*/o* path is implemented but UNTESTED

# Model per tier. Dispatch is by name prefix: claude-* -> Anthropic, gpt-*/o* -> OpenAI.
BRAIN_MODEL=claude-sonnet-...           # default tier (does the bulk of the work)
BRAIN_TOP_MODEL=claude-opus-...         # escalation tier (harder steps / stalls)

# --- Analysis VMs (SSH, key auth; key lives under .ssh_keys/ — you generate it) ---
KALI_HOST=192.168.x.x                   # Kali Linux VM address
KALI_USER=youruser
WIN_HOST=192.168.x.x                    # Windows VM address (optional; Windows targets)
WIN_USER=youruser

# --- Interpreter paths on the VMs (optional overrides) ---
# KALI_PYTHON=/home/youruser/ctf-venv/bin/python3
# WIN_PYTHON_EXE=C:\Users\youruser\AppData\Local\Programs\Python\Python314\python.exe

# --- Optional knobs (see agent/config.py for the full set) ---
# MAX_STEPS=20                          # hard per-challenge step cap
# MAX_RUN_TOKENS=0                      # optional token budget (0 = off)
# ALLOW_LOCAL_BRAIN=1                   # opt in to a local ollama fallback if BRAIN_MODEL is unset
